{
    "run_description": "CRNN_ResNetSE_K3x5-K3x5_Hop96_v10_Final",
    "run_mode": "train_only",
    "random_seed": 42,
    "paths": {
        "data_dir": "data/",      
        "audio_folder_name": "data/raw/morse_dataset/morse_dataset",
        "output_dir": "./outputs/",
        "generic_perlin_maps_dir": "data/external/perlin_maps/",
        "mlflow_tracking_uri": null,
        "background_noise_dir": "data/external/_background_noise_/"
    },
    "mlflow": {
        "experiment_name": "MorseCodeRecognition_v10_Final",
        "run_name_prefix": "MorseCRNN_Final"
    },
    "audio": {
        "sample_rate": 8000,
        "n_fft": 512,
        "hop_length": 96
    },
    "audio_augmentation": {
        "apply": true,
        "p": 1.0,
        "pipeline": [
            {
                "name": "AddGaussianNoise",
                "params": { "min_amplitude": 0.003, "max_amplitude": 0.015, "p": 0.8 }
            },
            {
                "name": "Gain",
                "params": { "min_gain_db": -10.0, "max_gain_db": 10.0, "p": 0.8 }
            },
            {
                "name": "ClippingDistortion",
                "params": { "min_percentile_threshold": 0, "max_percentile_threshold": 40, "p": 0.7 }
            }
        ]
    },
    "perlin_augmentation": {
        "apply": true,
        "p": 0.95,
        "amplitude_min": 0.2, "amplitude_max": 0.9,
        "chaos_amplitude_min": 0.0, "chaos_amplitude_max": 0.1,
        "chaos_type": "uniform",
        "offset_factor_min": 0.05, "offset_factor_max": 0.2
    },
    "additive_gaussian_augmentation": {
        "apply": true,
        "p": 0.9,
        "std_dev_min": 0.05, "std_dev_max": 0.15
    },
    "spec_augmentation": {
        "apply": true,
        "time_mask_param": 6, "num_time_masks": 25,
        "freq_mask_param": 5, "num_freq_masks": 10,
        "iid_masks": true
    },
    "model": {
        "cnn_type": "ResBlockSE",
        "cnn_block_channels": [ 32, 64 ],
        "cnn_kernel_size": [ [ 3, 5 ], [ 3, 5 ] ],
        "cnn_stride": [ [ 2, 2 ], [ 2, 2 ] ],
        "cnn_use_se": true,
        "cnn_se_reduction_ratio": 16
    },
    "training": {
        "apply_audio_augmentation": false,
        "epochs": 14,
        "batch_size": 16,
        "optimizer": "AdamW",
        "learning_rate": 0.0003,
        "weight_decay": 0.0001,
        "scheduler": "OneCycleLR",
        "use_amp": true,
        "gradient_accumulation_steps": 2,
        "gradient_clip_val": 1.0,
        "val_split_ratio": 0.1,
        "early_stopping_patience": 13
    },
    "finetuning": {
        "finetune_only_checkpoint_path": "./outputs/CRNN_ResNetSE_K3x5-K3x5_Hop96_v10_Final_train_only/MorseCRNN_Final_TRAIN_epoch8_lev0.4070.pth",
        "apply_audio_augmentation": true,
        "epochs": 20,
        "batch_size": 16,
        "learning_rate": 0.0003,
        "scheduler": "OneCycleLR",
        "early_stopping_patience": 10,
        "weight_decay": 0.0001,
        "use_amp": true,
        "gradient_accumulation_steps": 2,
        "gradient_clip_val": 1.0
    },
    "schedulers": {
        "OneCycleLR": {
            "pct_start": 0.1,
            "anneal_strategy": "cos",
            "div_factor": 5.0,
            "final_div_factor": 100.0,
            "verbose": false
        }
    },
    "ctc": {
        "blank_char": "<blank>",
        "blank_idx": 0,
        "pad_char": "<pad>",
        "pad_idx": -1
    },
    "device": "cuda",
    "num_workers": 0,
    "train_file_column": "id",
    "test_file_column": "id",
    "morse_code_column": "message"
}