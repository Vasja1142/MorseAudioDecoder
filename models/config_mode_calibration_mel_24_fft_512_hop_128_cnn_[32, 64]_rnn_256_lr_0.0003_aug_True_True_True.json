{
    "data_cfg": {
        "train_csv_path": "train.csv",
        "audio_dir": "morse_dataset\\morse_dataset",
        "val_split": 0.15,
        "subset_fraction": 0.2
    },
    "feature_cfg": {
        "sample_rate": 8000,
        "n_mels": 24,
        "n_fft": 512,
        "hop_length": 128,
        "fmax": 4200,
        "use_deltas": false,
        "delta_order": 1,
        "delta_window": 5
    },
    "augment_cfg": {
        "augment_prob": 0.7,
        "use_noise": true,
        "noise_level": 0.005,
        "use_gain": true,
        "gain_range": [
            0.7,
            1.3
        ],
        "use_specaugment": true,
        "freq_mask_param": 5,
        "num_freq_masks": 2,
        "time_mask_param": 3,
        "num_time_masks": 3,
        "time_mask_prob": 0.3
    },
    "model_cfg": {
        "cnn_out_channels": [
            32,
            64
        ],
        "cnn_kernel_sizes": [
            [
                3,
                3
            ],
            [
                3,
                3
            ]
        ],
        "cnn_strides": [
            [
                1,
                1
            ],
            [
                1,
                1
            ]
        ],
        "pool_kernel_sizes": [
            [
                1,
                2
            ],
            [
                2,
                2
            ]
        ],
        "pool_strides": [
            [
                1,
                2
            ],
            [
                2,
                2
            ]
        ],
        "rnn_hidden_size": 256,
        "rnn_layers": 2,
        "rnn_dropout": 0.2,
        "bidirectional": true,
        "dropout": 0.2
    },
    "train_cfg": {
        "mode": "calibration",
        "batch_size": 32,
        "epochs": 15,
        "learning_rate": 0.0003,
        "weight_decay": 1e-05,
        "optimizer": "AdamW",
        "scheduler": "ReduceLROnPlateau",
        "scheduler_patience": 5,
        "scheduler_factor": 0.3,
        "lr_min": 1e-06,
        "clip_grad_norm": 1.0,
        "use_amp": true,
        "gradient_accumulation_steps": 1,
        "num_workers": 4,
        "early_stopping_patience": 5,
        "mlflow_experiment_name": "Morse Code Recognition"
    },
    "seed": 42,
    "device": "cuda"
}